<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Connection360.Etl.App</RootNamespace>
    <!-- Habilita la generación del XML de documentación a partir de los comentarios ///. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Connection360.Etl.App.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Connection360.Etl.Application\Connection360.Etl.Application.csproj" />
    <ProjectReference Include="..\Connection360.Etl.Infrastructure\Connection360.Etl.Infrastructure.csproj" />
    <ProjectReference Include="..\Connection360.Observability.Application\Connection360.Observability.Application.csproj" />
    <ProjectReference Include="..\Connection360.Observability.Infrastructure.Mongo\Connection360.Observability.Infrastructure.Mongo.csproj" />
    <ProjectReference Include="..\Connection360.Observability.Domain\Connection360.Observability.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
