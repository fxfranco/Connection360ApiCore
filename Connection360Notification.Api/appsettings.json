{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Secret": "",
    "Roles": ""
  },
  "Persistence": {
    "Provider": ""
  },
  "MongoDbSettings": {
    "ConnectionString": "",
    "DatabaseName": "",
    "CollectionName": ""
  },
  "KafkaSettings": {
    "BootstrapServers": "",
    "GroupId": "",
    "Topic": ""
  },
  "Observability": {
    "Enabled": true,
    "ShutdownTimeoutSeconds": 10,
    "Logs": {
      "Enabled": true,
      "MinimumLevel": "Information",
      "QueueCapacity": 10000,
      "BatchSize": 200,
      "FlushIntervalSeconds": 2
    },
    "Metrics": {
      "Enabled": true,
      "CollectionIntervalSeconds": 30,
      "QueueCapacity": 10000,
      "BatchSize": 200,
      "FlushIntervalSeconds": 2
    },
    "Traces": {
      "Enabled": true,
      "SamplingRatio": 1.0,
      "QueueCapacity": 10000,
      "BatchSize": 200,
      "FlushIntervalSeconds": 2,
      "ExcludePaths": [ "/health" ]
    },
    "Mongo": {
      "ConnectionString": "",
      "DatabaseName": "",
      "LogsCollection": "notificationLogs",
      "MetricsCollection": "notificationMetrics",
      "TracesCollection": "notificationTraces",
      "LogsRetentionDays": 30,
      "MetricsRetentionDays": 90,
      "TracesRetentionDays": 14
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "https://localhost:44370"
      }
    }
  }
}
