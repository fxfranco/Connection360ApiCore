<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Connection360.Etl.Orchestrator</RootNamespace>
		<!-- Habilita la generación del XML de documentación a partir de los comentarios ///. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<Version>1.0.0-alphaBaseInit.1</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<AssemblyFileVersion>1.0.0.0</AssemblyFileVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Sin dependencias externas de scheduling (Cronos, Quartz, etc.): la expresión cron se
         parsea con Connection360.Etl.Orchestrator.Scheduling.CronExpression, una implementación
         propia y deliberadamente simple, para no fijar una versión de NuGet que no se puede
         verificar contra el feed desde este entorno de trabajo. -->
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.Development.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
