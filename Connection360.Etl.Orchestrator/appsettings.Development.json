{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Orchestrator": {
    "CronJobs": [
      {
        "Name": "Connection360.Etl.App",
        "Enabled": true,
        "CronExpression": "*/1 * * * *",
        "TimeZoneId": "America/Bogota",
        "ExecutablePath": "dotnet",
        "Arguments": "Connection360.Etl.App.dll",
        "WorkingDirectory": "../../../../Connection360.Etl.App/bin/Debug/net10.0",
        "TimeoutMinutes": 15
      }
    ]
  }
}
