{
  "openapi": "3.0.1",
  "info": {
    "title": "Connection 360 API Notifications",
    "version": "v1"
  },
  "paths": {
    "/api/v1/notifications/allnotifications": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Obtiene todas las notificaciones asociadas a un cliente.",
        "parameters": [
          {
            "name": "idClient",
            "in": "query",
            "description": "Identificador del cliente cuyas notificaciones se desean consultar.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de notificaciones del cliente (puede estar vacía).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Connection360Notification.Application.DTOs.NotificationsListResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/readnotification/{idClient}/{idNotification}": {
      "patch": {
        "tags": [
          "Notifications"
        ],
        "summary": "Marca una notificación puntual de un cliente como leída.",
        "parameters": [
          {
            "name": "idClient",
            "in": "path",
            "description": "Identificador del cliente propietario de la notificación.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idNotification",
            "in": "path",
            "description": "Identificador secuencial de la notificación a marcar como leída.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "La notificación fue marcada como leída correctamente."
          },
          "404": {
            "description": "No existe una notificación con el identificador indicado para ese cliente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Microsoft.AspNetCore.Mvc.ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/notifications/allnotificationslistTest": {
      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Obtiene todas las notificaciones almacenadas, sin filtrar por cliente.",
        "description": "Endpoint de prueba (nombre \"allnotificationslistTest\") habilitado con `[AllowAnonymous]`, es decir,\r\nno requiere autenticación. Devuelve directamente las entidades de dominio Connection360Notification.Domain.NotificationMessage\r\ntal como están almacenadas.",
        "responses": {
          "200": {
            "description": "Lista completa de notificaciones.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Connection360Notification.Domain.NotificationMessage"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
