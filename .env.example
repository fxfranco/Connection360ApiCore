# ==================================================================================================
# Connection360 - variables de entorno para docker compose.
#   1) Copia este archivo a ".env" (que NO se versiona: *.env está en .gitignore) y completa los valores.
#   2) docker compose up -d
# En un hosting en la nube, estas mismas variables se definen en el panel del servicio (secretos incluidos).
# ==================================================================================================

# ---------- Imágenes (Docker Hub) ----------
REGISTRY=CAMBIAR
# Versiones a desplegar (las genera deploy/build-images.* a partir del <Version> de cada .csproj; ver deploy/versions.env).
# Si se omiten se usa "latest".
APIGATEWAY_VERSION=CAMBIAR
API_VERSION=CAMBIAR
NOTIFICATION_API_VERSION=CAMBIAR
ETL_ORCHESTRATOR_VERSION=CAMBIAR
ETL_APP_VERSION=CAMBIAR

# ---------- Red Docker compartida con PostgreSQL, MongoDB y Kafka ----------
# Debe existir (docker network create connection360-network) y los contenedores de BD/Kafka deben estar conectados a ella.
DOCKER_NETWORK=connection360-network

# ---------- API Gateway (único expuesto al front) ----------
GATEWAY_HTTP_PORT=CAMBIAR
GATEWAY_HTTPS_PORT=CAMBIAR
# Carpeta del equipo que contiene el .pfx y nombre del archivo. El certificado se monta, no va dentro de la imagen.
GATEWAY_CERT_DIR=CAMBIAR
GATEWAY_CERT_FILE=CAMBIAR
GATEWAY_CERT_PASSWORD=CAMBIAR
# false = acepta HTTP y HTTPS sin redirigir | true = redirige HTTP -> HTTPS
GATEWAY_HTTPS_REDIRECT=CAMBIAR
# Orígenes del front permitidos por CORS (hasta 4; deja vacíos los que no uses)
CORS_ORIGIN_0=CAMBIAR
CORS_ORIGIN_1=CAMBIAR
CORS_ORIGIN_2=CAMBIAR
CORS_ORIGIN_3=CAMBIAR
# Destinos internos del gateway (nombres de servicio de este compose; cámbialos si los servicios corren en otro lado)
CORE_API_URL=CAMBIAR
NOTIFICATION_API_URL=CAMBIAR
RATE_LIMIT_PERMIT_LIMIT=CAMBIAR
RATE_LIMIT_WINDOW_SECONDS=CAMBIAR
RATE_LIMIT_QUEUE_LIMIT=CAMBIAR
JWT_ACCESS_TOKEN_MINUTES=CAMBIAR
JWT_REFRESH_TOKEN_DAYS=CAMBIAR

# ---------- JWT (gateway + APIs) ----------
JWT_ISSUER=CAMBIAR
JWT_AUDIENCE=CAMBIAR
JWT_ROLES=CAMBIAR
JWT_SECRET=CAMBIAR

# ---------- PostgreSQL (contenedor externo: usa su nombre de contenedor/servicio como Host) ----------
POSTGRES_CONNECTION=CAMBIAR

# ---------- MongoDB (contenedor externo) ----------
MONGO_CONNECTION=CAMBIAR
MONGO_DATABASE=CAMBIAR
MONGO_NOTIFICATION_COLLECTION=CAMBIAR
# Colección donde Connection360Notification.Api guarda los usuarios de Auth0 sincronizados (id, identificación, correo, teléfono).
MONGO_BASIC_USER_COLLECTION=CAMBIAR
OBSERVABILITY_ENABLED=CAMBIAR

# ---------- Kafka (contenedor externo) ----------
# Debe ser la dirección que Kafka anuncia a los clientes DENTRO de la red Docker (listener interno), p. ej. kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=CAMBIAR
KAFKA_GROUP_ID=CAMBIAR
KAFKA_TOPIC=CAMBIAR

# ---------- Auth0 Management (Connection360.Api) ----------
AUTH0_DOMAIN=CAMBIAR
AUTH0_CLIENT_ID=CAMBIAR
AUTH0_CLIENT_SECRET=CAMBIAR
OUTBOX_POLLING_INTERVAL_SECONDS=CAMBIAR
OPENSTREETMAP_BASE_URL=CAMBIAR
OPENSTREETMAP_API_KEY=

# ---------- Sincronización de usuarios Auth0 -> Notification (Connection360.Api publica, Connection360Notification.Api consume) ----------
# El Api consulta los usuarios de Auth0 al arrancar y luego cada USER_SYNC_INTERVAL_MINUTES, y los publica en el tópico USER_SYNC_TOPIC
# (debe existir en Kafka o el broker debe tener la creación automática de tópicos). Estos valores ya traen su valor por defecto.
# De cada usuario se envían el id de Auth0, su correo y, de su user_metadata, document, fullName y phone.number.
USER_SYNC_ENABLED=CAMBIAR
USER_SYNC_TOPIC=CAMBIAR
USER_SYNC_INTERVAL_MINUTES=CAMBIAR
USER_SYNC_BATCH_SIZE=CAMBIAR
USER_SYNC_STARTUP_RETRY_SECONDS=CAMBIAR
# Grupo de consumo del tópico de usuarios en Notification. Vacío = "<KAFKA_GROUP_ID>-users".
USER_SYNC_GROUP_ID=CAMBIAR

# ---------- Correo (Connection360Notification.Api) ----------
SMTP_SERVER=CAMBIAR
SMTP_PORT=CAMBIAR
SMTP_SENDER_NAME=CAMBIAR
SMTP_SENDER_EMAIL=CAMBIAR
# Contraseña de APLICACIÓN de Gmail (requiere verificación en 2 pasos), no la contraseña normal.
SMTP_PASSWORD=CAMBIAR
# Correo de RESPALDO: se usa solo si el cliente no existe en basicUserData o no tiene un correo valido
# (si lo tiene, el correo se envia al Email del cliente).
SMTP_RECIPIENT_EMAIL=CAMBIAR
# URL de Conexion360 que aparece como "Consultar mi envio" en el correo (http/https). Vacia = el correo va sin enlace.
SMTP_CONEXION360_URL=CAMBIAR
SMTP_TIMEOUT_SECONDS=CAMBIAR
# Pon false SOLO si el servidor no alcanza los servidores de revocación del certificado (CRL/OCSP).
SMTP_CHECK_CERT_REVOCATION=CAMBIAR

# ---------- ETL (Connection360.Etl.Orchestrator / Connection360.Etl.App) ----------
# Programación del ETL (cron de 5 campos) y zona horaria
ETL_ENABLED=CAMBIAR
ETL_CRON=CAMBIAR
ETL_TIMEZONE=CAMBIAR
ETL_TIMEOUT_MINUTES=CAMBIAR
ETL_JOB_CONTROL_RETENTION_DAYS=CAMBIAR
ETL_VIEWS_REFRESH_ENABLED=CAMBIAR
ETL_VIEWS_COMMAND_TIMEOUT_SECONDS=CAMBIAR
ETL_SYSTEM_USER=CAMBIAR
EXTERNAL_API_TIMEOUT_SECONDS=CAMBIAR
EXTERNAL_API_PAGINATION_ENABLED=CAMBIAR
EXTERNAL_API_PAGE_SIZE=CAMBIAR
# SOLO DESARROLLO: true = el ETL NO valida el certificado TLS de las APIs externas (certificado de desarrollo
# emitido para "localhost" al consumirlas por IP, autofirmado, etc.). Dejar en false en producción.
EXTERNAL_API_ALLOW_INVALID_CERT=CAMBIAR
# APIs externas (equipo Windows). Desde el contenedor "localhost" es el propio contenedor: usa la IP/nombre del equipo
# o "host.docker.internal" si las APIs corren en la misma máquina que Docker.
BPMS_BASE_URL=CAMBIAR
BPMS_API_KEY=
DATALOGS_BASE_URL=CAMBIAR
DATALOGS_API_KEY=
SIM_BASE_URL=CAMBIAR
SIM_API_KEY=
OPENCOMEX_BASE_URL=CAMBIAR
OPENCOMEX_API_KEY=
ASISCOMEX_BASE_URL=CAMBIAR
ASISCOMEX_API_KEY=
SYSTEMCARRIER_BASE_URL=CAMBIAR
SYSTEMCARRIER_API_KEY=
