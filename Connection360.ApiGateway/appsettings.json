{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://identity.miempresa.com",
    "Audience": "products-api",
    "Secret": "CAMBIAR_ESTE_SECRETO_POR_UNO_FUERTE_EN_USER_SECRETS_O_KEYVAULT_MIN_32_CHARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },

  "Cors": {
    "AllowedOrigins": [
      "https://miapp.miempresa.com",
      "https://localhost:5173"
    ]
  },

  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" },
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "ApiGateway"
          }
        ]
      }
    },
    "Clusters": {
      "products-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            //"Address": "https://localhost:5101/"
            "Address": "https://localhost:44369/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  }
}
