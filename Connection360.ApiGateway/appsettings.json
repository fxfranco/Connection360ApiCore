{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Audience": "https://api.conexion360.com",
    "Issuer": "https://dev-5lxfpxxjzz7ikezw.us.auth0.com/",
    "Secret": "CAMBIAR_ESTE_SECRETO_POR_UNO_FUERTE_EN_USER_SECRETS_O_KEYVAULT_MIN_32_CHARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "Roles": "https://conexion360.space/roles"
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Cors": {
    "AllowedOrigins": [
      "https://miapp.miempresa.com",
      "https://localhost:5173",
      "http://localhost:4200"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "signalr-route": {
        "ClusterId": "signalr-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v{version}/hubs/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "ApiGateway"
          }
        ]
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" },
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "ApiGateway"
          }
        ]
      }

    },
    "Clusters": {
      "products-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            //"Address": "https://localhost:5101/"
            "Address": "https://localhost:44369/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "signalr-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            //"Address": "https://localhost:5101/"
            "Address": "https://localhost:44369/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:05:00",
          "AllowResponseBuffering": false
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "https://localhost:44368"
      }
    }
  }
}
