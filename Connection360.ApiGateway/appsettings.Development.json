{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Audience": "",
    "Issuer": "",
    "Secret": "",
    "AccessTokenMinutes": 0,
    "RefreshTokenDays": 0,
    "Roles": ""
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Cors": {
    "AllowedOrigins": [
      ""
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "signalr-route": {
        "ClusterId": "signalr-cluster",
        "Order": 1,
        "Match": {
          "Path": "/api/v{version}/hubs/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "ApiGateway"
          }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Order": 2,
        "Match": {
          "Path": "/api/v{version}/notifications/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/v{version}/notifications/{**catch-all}" },
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "ApiGateway"
          }
        ]
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Order": 3,
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" },
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "ApiGateway"
          }
        ]
      }
    },
    "Clusters": {
      "signalr-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:44370/"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:05:00",
          "AllowResponseBuffering": false
        }
      },
      "notification-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:44370/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "products-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:44369/"
          }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "https://localhost:44368"
      }
    }
  }
}
