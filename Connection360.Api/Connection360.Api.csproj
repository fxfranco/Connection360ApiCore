<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Connection360.Api</RootNamespace>
		<Version>1.0.0-alphaBaseInit.1</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<AssemblyFileVersion>1.0.0.0</AssemblyFileVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<ItemGroup>
		<!--<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />-->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
		<PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.0" />
		<PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
		<!--<PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="8.0.2" />-->
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Connection360.Application\Connection360.Application.csproj" />
		<ProjectReference Include="..\Connection360.Infrastructure\Connection360.Infrastructure.csproj" />
	</ItemGroup>

	<!-- Necesario para que Connection360.Api.IntegrationTests pueda usar WebApplicationFactory<Program>:
	     con top-level statements, la clase Program generada es 'internal'. Esto NO cambia
	     ningún comportamiento en tiempo de ejecución de la aplicación. -->
	<ItemGroup>
		<InternalsVisibleTo Include="Connection360.Api.IntegrationTests" />
	</ItemGroup>

</Project>
