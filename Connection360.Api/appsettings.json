  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Secret": "",
    "Roles": ""
  },
  "Auth0Management": {
    "Domain": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "KafkaSettings": {
    "BootstrapServers": "",
    "GroupId": "",
    "Topic": ""
  },
  "OutboxPublisher": {
    "PollingIntervalSeconds": 10
  },
  "Auth0UserSync": {
    "Enabled": true,
    "Topic": "notification-users",
    "PollingIntervalMinutes": 60,
    "BatchSize": 200,
    "StartupRetryDelaySeconds": 30
  },
  "Observability": {
    "Enabled": true,
    "ShutdownTimeoutSeconds": 10,
    "Logs": { "Enabled": true, "MinimumLevel": "Information", "QueueCapacity": 10000, "BatchSize": 200, "FlushIntervalSeconds": 2 },
    "Metrics": { "Enabled": true, "CollectionIntervalSeconds": 30, "QueueCapacity": 10000, "BatchSize": 200, "FlushIntervalSeconds": 2 },
    "Traces": { "Enabled": true, "SamplingRatio": 1.0, "QueueCapacity": 10000, "BatchSize": 200, "FlushIntervalSeconds": 2, "ExcludePaths": [ "/health" ] },
    "Mongo": {
      "ConnectionString": "",
      "DatabaseName": "",
      "LogsCollection": "notificationLogs",
      "MetricsCollection": "notificationMetrics",
      "TracesCollection": "notificationTraces",
      "LogsRetentionDays": 30,
      "MetricsRetentionDays": 90,
      "TracesRetentionDays": 14
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "https://localhost:44369"
      }
    }
  },
  "ExternalApi": {
    "Apis": {
      "OPENSTREETMAP": {
        "BaseUrl": "https://nominatim.openstreetmap.org",
        "DataEndpoint": "/search?q=",
        "ApiKey": "",
        "TimeoutSeconds": 30
      }
    }
  },
  "CoordinatesCache": {
    "Enabled": true,
    "MaxSizeBytes": 10485760,
    "EvictionPercentage": 0.2,
    "AbsoluteExpiration": "30.00:00:00",
    "SlidingExpiration": "7.00:00:00",
    "MaxKeyLength": 200
  }
